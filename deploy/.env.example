# ============================================
# Docker Compose Configuration
# ============================================
SERVICE_NAME=roham
SERVICE_DOMAIN=roham.local
COMPOSE_PROJECT_NAME=roham

# Go Build Configuration
GO_IMAGE_NAME=golang
GO_IMAGE_VERSION=1.25-alpine3.21

# ============================================
# User Service Database Configuration
# ============================================
USER_DB_NAME=user_db
USER_DB_USER=user_admin
USER_DB_PASSWORD=password123
USER_DB_PORT=5433

# User Service Redis Configuration
USER_REDIS_HOST=user-redis
USER_REDIS_PORT=6379

# User Service Application Configuration
USER__POSTGRES_DB__HOST=user-db
USER__POSTGRES_DB__PORT=5432
USER__POSTGRES_DB__USER=user_admin
USER__POSTGRES_DB__PASSWORD=password123
USER__POSTGRES_DB__DB_NAME=user_db
USER__REDIS__HOST=user-redis
USER__REDIS__PORT=6379

# ============================================
# Filer Service Database Configuration
# ============================================
FILER_DB_NAME=filer_db
FILER_DB_USER=roham
FILER_DB_PASSWORD=secret
FILER_DB_PORT=5433

# Filer Service Application Configuration
FILER__POSTGRES_DB__HOST=filer-db
FILER__POSTGRES_DB__PORT=5432
FILER__POSTGRES_DB__USER=roham
FILER__POSTGRES_DB__PASSWORD=secret
FILER__POSTGRES_DB__DB_NAME=filer_db

# ============================================
# Vectorlayer Service Database Configuration
# ============================================
VECTORLAYER_DB_NAME=vectorlayer_db
VECTORLAYER_DB_USER=vectorlayer_admin
VECTORLAYER_DB_PASSWORD=password123
VECTORLAYER_DB_PORT=5434

# Vectorlayer Service Redis Configuration
VECTORLAYER_REDIS_HOST=vectorlayer-redis
VECTORLAYER_REDIS_PORT=6379

# Vectorlayer Service Application Configuration
VECTORLAYER__POSTGRES_DB__HOST=vectorlayer-db
VECTORLAYER__POSTGRES_DB__PORT=5432
VECTORLAYER__POSTGRES_DB__USER=vectorlayer_admin
VECTORLAYER__POSTGRES_DB__PASSWORD=password123
VECTORLAYER__POSTGRES_DB__DB_NAME=vectorlayer_db
VECTORLAYER__REDIS__HOST=vectorlayer-redis
VECTORLAYER__REDIS__PORT=6379
